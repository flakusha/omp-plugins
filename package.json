{
  "name": "omp-plugins",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Installable oh-my-pi (omp) plugin bundle — extensions, hooks, skills, and agent config scaffold.",
  "workspaces": [
    "plugins/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@oh-my-pi/pi-coding-agent": "17.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check plugins scripts",
    "lint:fix": "biome check --write plugins scripts",
    "format": "biome format --write plugins scripts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "verify": "bun run lint && bun run typecheck && bun run test",
    "install:test": "bash scripts/install.sh --target /tmp/omp-test"
  }
}